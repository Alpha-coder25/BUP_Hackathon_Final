# Fuel Supply Intelligence & Resilience Platform
# Copy to .env — secrets stay out of git (see .gitignore).

# Simulator (organizer-provided docker image)
SIM_URL=http://localhost:8000

# Database (docker compose service `db`)
DB_URL=postgresql+psycopg://fuel:change_me@localhost:5432/fuel

# Redis (tick queue / cache hot path)
REDIS_URL=redis://localhost:6379/0

# GenAI explainer (template fallback if unset)
LLM_API_KEY=

# Collector
COLLECTOR_POLL_SECONDS=30

# Backend API port
PORT=8080
